{
  "name": "sds-desktop-electron",
  "version": "2.2.0",
  "private": true,
  "description": "Windows desktop distributor path for Sheep Dog Simulator.",
  "author": "Matthew Kissinger",
  "license": "AGPL-3.0-or-later",
  "main": "main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/matthew-kissinger/sds.git"
  },
  "scripts": {
    "prepare:icons": "node scripts/prepare-icons.mjs",
    "start": "npm run prepare:icons && electron .",
    "pack:win": "npm run prepare:icons && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win dir --x64 --publish never",
    "dist:win": "npm run prepare:icons && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis portable --x64 --publish never",
    "proof": "node proof.mjs",
    "proof:packaged": "node proof.mjs --packaged",
    "proof:webgl": "node proof.mjs --packaged --renderer=webgl",
    "proof:webgpu": "node proof.mjs --packaged --renderer=webgpu",
    "check": "npm run dist:win && npm run proof:webgl && npm run proof:webgpu"
  },
  "dependencies": {},
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "42.3.3",
    "electron-builder": "26.8.1",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "com.matthewkissinger.sheepdogsim",
    "productName": "Sheep Dog Simulator",
    "copyright": "Copyright (c) 2026 Matthew Kissinger",
    "directories": {
      "buildResources": "build",
      "output": "../../cycle54-validation/desktop-electron/artifacts"
    },
    "files": [
      "main.cjs",
      "package.json",
      "build/icon.ico",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../../dist",
        "to": "dist"
      }
    ],
    "asar": true,
    "compression": "normal",
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "Sheep Dog Simulator",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": true,
      "forceCodeSigning": false
    },
    "nsis": {
      "artifactName": "SheepDogSimulator-${version}-setup-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sheep Dog Simulator"
    },
    "portable": {
      "artifactName": "SheepDogSimulator-${version}-portable-${arch}.${ext}"
    }
  }
}
