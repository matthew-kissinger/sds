# Picks file IS committed; staging is regenerable via `npm run gen:meshy`.
tools/asset-gallery/staging/
tests/perf-baseline/last-run.json

# Cycle validation artifacts (screenshots, runtime JSON, perf traces).
# These are per-run proof — regenerable, scene/device-specific, and not
# collaboratively edited. Keep them out of git to stop pack growth.
cycle*-validation/

# Cycle 105 keeps small markdown decision/audit summaries tracked; bulky proof
# artifacts in the same validation directory remain ignored.
!cycle105-validation/
cycle105-validation/*
!cycle105-validation/r185-release-audit.md
!cycle105-validation/three-r185-example-notes.md
