# Node.js dependencies
server/node_modules/
server/package-lock.json

# Server build artifacts  
server/.fly/
server/Dockerfile
server/.dockerignore

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# nyc test coverage
.nyc_output

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.local
.env.*.local

# Wrangler local-dev secrets (prod secrets live in `wrangler secret put`)
.dev.vars
worker/.dev.vars

# Wrangler local cache + state (workerd, D1 sqlite shadow, KV, etc.)
.wrangler/
worker/.wrangler/

# SQLite database files (live data - never commit)
*.db
*.db-shm
*.db-wal

# VS Code
.vscode/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp 
# Claude Code local settings — ignore children, but re-include shared slash commands so they ship with the repo
.claude/*
!.claude/commands/
!.claude/commands/**

# Playwright MCP artifacts
.playwright-mcp/

# Playwright test artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Cinematic capture intermediates (regenerable via `npm run cinema`)
tools/cinematic/output/
# Marketing video output (too large for git; ship via CDN if needed)
assets/marketing/videos/

# Build output
dist/
dist-react/

# itch.io build artifacts
dist-itchio/
sheep-dog-sim-itchio.zip

# Playtest screenshots (ephemeral)
cycle2-*.png
phase-b-*.png
phase2-*.png
phase3-*.png
prod-*.png
verify-*.png
verify[0-9]*-*.png

# GLB compression backups (regenerable from git history if rolled back)
assets/_originals/
