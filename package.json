{
  "name": "sheepdog-sim",
  "private": true,
  "version": "3.2.0",
  "description": "A focused browser herding game built with Three.js, React and a deterministic simulation.",
  "author": "Matthew Kissinger",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://sheepdogsim.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthew-kissinger/sds.git"
  },
  "keywords": [
    "threejs",
    "react-three-fiber",
    "typescript",
    "webgpu",
    "webgl2",
    "sheepdog",
    "sheepdog-sim",
    "herding",
    "herding-game",
    "browser-game",
    "web-game",
    "single-player",
    "simulation"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lab": "vite --config vite.lab.config.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:lab": "tsc --noEmit -p tsconfig.lab.json",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "probe:release": "node tools/release-hardening-probe.mjs",
    "probe:playtest": "node tools/playtest-profile.mjs",
    "review:art": "node tools/art-review.mjs",
    "probe:boot": "node tools/boot-probe.mjs",
    "capture:launch": "node tools/launch-media-capture.mjs",
    "check:discovery": "node scripts/verify-public-discovery.mjs --require-analytics",
    "lint": "eslint .",
    "bake:terrain": "node tools/bake-terrain.mjs",
    "bake:grass": "node tools/bake-grass.mjs",
    "bake:placement": "node tools/bake-world-placement.mjs",
    "bake:audio": "node tools/bake-audio.mjs",
    "check:audio-bake": "node tools/bake-audio.mjs --check",
    "bake:font": "uv run --quiet --with fonttools[woff] --with brotli python tools/subset-font.py",
    "check:font-bake": "uv run --quiet --with fonttools[woff] --with brotli python tools/subset-font.py --check"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "kdbush": "^4.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261016.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "4.151.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
