{
  "name": "sheepdog-sim",
  "private": true,
  "version": "3.0.0",
  "description": "A focused browser herding game built with Three.js, React and a deterministic simulation.",
  "author": "Matthew Kissinger",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://sheepdogsim.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthew-kissinger/sds.git"
  },
  "keywords": [
    "threejs",
    "react-three-fiber",
    "typescript",
    "webgpu",
    "webgl2",
    "sheepdog",
    "sheepdog-sim",
    "herding",
    "herding-game",
    "browser-game",
    "web-game",
    "single-player",
    "simulation"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:worker": "npm run typecheck --prefix worker",
    "probe:release": "node tools/release-hardening-probe.mjs",
    "probe:playtest": "node tools/playtest-profile.mjs",
    "probe:boot": "node tools/boot-probe.mjs",
    "capture:launch": "node tools/launch-media-capture.mjs",
    "check:discovery": "node scripts/verify-public-discovery.mjs",
    "lint": "eslint .",
    "bake:terrain": "node tools/bake-terrain.mjs",
    "bake:grass": "node tools/bake-grass.mjs",
    "bake:placement": "node tools/bake-world-placement.mjs",
    "bake:audio": "node tools/bake-audio.mjs",
    "check:audio-bake": "node tools/bake-audio.mjs --check",
    "bake:font": "node tools/bake-font.mjs",
    "check:font-bake": "node tools/bake-font.mjs --check"
  },
  "dependencies": {
    "kdbush": "^4.0.2",
    "@react-three/fiber": "9.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zustand": "5.0.15",
    "@pmndrs/glyph": "^0.0.0"
  },
  "overrides": {
    "@pmndrs/glyph": {
      "@react-three/fiber": "$@react-three/fiber"
    }
  },
  "devDependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitejs/plugin-react": "^5.1.4",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.2",
    "playwright": "^1.62.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.4",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
