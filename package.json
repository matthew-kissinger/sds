{
  "name": "sheep-dog-sim",
  "version": "2.3.0",
  "description": "An interactive herding game where players control a sheepdog to guide sheep into a pen using boid flocking algorithms",
  "type": "module",
  "main": "index.html",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -n client,worker -c cyan,magenta \"npm:dev:client\" \"npm:dev:worker\"",
    "dev:client": "vite --port 3000",
    "dev:worker": "cd worker && npx wrangler dev",
    "dev:lan": "concurrently -n client,worker -c cyan,magenta \"vite --port 3000 --host\" \"npm:dev:worker\"",
    "dev:setup": "node scripts/d1-local-setup.mjs",
    "build": "vite build",
    "build:itchio": "cross-env BUILD_TARGET=itchio vite build",
    "build:native": "cross-env BUILD_TARGET=native vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test:integration": "vitest run tests/integration",
    "lint": "eslint shared/ js/",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:ios-water": "node tools/browserstack/run-ios-water.mjs",
    "proof:first-session": "node tools/newsheepdogland-first-session-proof.mjs",
    "cinema": "node tools/cinematic/run.mjs",
    "clean": "rm -rf dist node_modules/.vite",
    "compress-glbs": "node scripts/compress-glbs.mjs",
    "bake-trees": "node tools/bake-trees.mjs",
    "bake-tree-impostors": "node tools/bake-tree-impostors.mjs",
    "bake-tree-lod1": "node tools/bake-tree-lod1.mjs",
    "bake-tree-mobile-budgets": "node tools/bake-mobile-tree-budgets.mjs",
    "bake-rocks": "node tools/bake-rocks.mjs",
    "gallery": "node tools/asset-gallery.mjs",
    "gen:meshy": "node tools/asset-gen/meshy.mjs",
    "gen:integrate": "node tools/asset-gen/integrate.mjs",
    "perf:baseline": "node tools/perf-harness.mjs --baseline",
    "perf:check": "node tools/perf-harness.mjs --check",
    "perf:collision": "node tools/collision-stutter-probe.mjs",
    "perf:android-webgpu": "node tools/android-webgpu-perf.mjs",
    "perf:cycle38-desktop": "node tools/perf-harness.mjs --capture --renderer=webgpu --configs=field-classic,rolling-hills-classic,open-country-classic --poses=all --systems=full --warmup=2 --measure=5 --budget=high --screenshots --out=cycle38-validation/runtime/desktop-webgpu-cycle38-poses.json --screenshotDir=cycle38-validation/screenshots/desktop-webgpu-cycle38-poses",
    "perf:cycle38-desktop-systems": "node tools/perf-harness.mjs --capture --renderer=webgpu --configs=rolling-hills-classic --poses=follow-close --systems=all --warmup=2 --measure=5 --budget=high --screenshots --out=cycle38-validation/runtime/desktop-webgpu-cycle38-systems.json --screenshotDir=cycle38-validation/screenshots/desktop-webgpu-cycle38-systems",
    "perf:cycle38-android": "node tools/android-webgpu-perf.mjs --matrix=1 --scenes=field,rolling-hills,open-country --poses=all --systems=full --warmup=2000 --measure=5000 --budget=high --screenshots=1 --out=cycle38-validation/runtime/android-webgpu-cycle38-poses.json --screenshotDir=cycle38-validation/screenshots/android-webgpu-cycle38-poses --printJson=0",
    "perf:cycle38-android-systems": "node tools/android-webgpu-perf.mjs --matrix=1 --scenes=rolling-hills --poses=follow-close --systems=all --warmup=2000 --measure=5000 --budget=high --screenshots=1 --out=cycle38-validation/runtime/android-webgpu-cycle38-systems.json --screenshotDir=cycle38-validation/screenshots/android-webgpu-cycle38-systems --printJson=0",
    "perf:dog-sprint": "node tools/dog-sprint-camera-harness.mjs --target=desktop --renderer=webgpu --scene=rolling-hills --cameraModes=follow,classic --zooms=near,mid,far --duration=18000 --screenshots=1",
    "perf:android-dog-sprint": "node tools/dog-sprint-camera-harness.mjs --target=android --renderer=webgpu --scene=rolling-hills --cameraModes=follow,classic --zooms=near,mid,far --duration=18000 --screenshots=1 --out=cycle38-validation/runtime/android-dog-sprint-camera-harness.json --screenshotDir=cycle38-validation/screenshots/android-dog-sprint-camera",
    "probe:webgpu": "node tools/probe-webgpu-runtime.mjs",
    "probe:webgpu-impostor-lab": "node tools/webgpu-impostor-lab-proof.mjs",
    "probe:tree-placement": "node tools/tree-placement-diagnostics.mjs",
    "konveyor:renderer-telemetry": "node tools/konveyor-renderer-telemetry-summary.mjs --remote",
    "native:preflight": "node tools/native-preflight.mjs",
    "native:check": "npm run build:native && npm run native:preflight",
    "desktop:install": "npm --prefix native/desktop-electron install",
    "desktop:pack": "npm run build:native && npm --prefix native/desktop-electron run pack:win",
    "desktop:dist": "npm run build:native && npm --prefix native/desktop-electron run dist:win",
    "desktop:proof": "npm --prefix native/desktop-electron run proof:packaged",
    "desktop:check": "npm run build:native && npm --prefix native/desktop-electron run check",
    "validation:lod": "node tools/validation/lod-compare.mjs",
    "validation:screenshots": "node tools/validation/screenshot-golden.mjs",
    "validation:cycle41-art-lock": "node tools/cycle41-art-lock.mjs",
    "validation:cycle42-material-lock": "node tools/cycle42-material-lock.mjs",
    "validation:cycle42-octahedral-proof": "node tools/cycle42-octahedral-proof.mjs",
    "validation:latency": "node tools/validation/input-latency.mjs",
    "validation:latency:mobile": "node tools/validation/input-latency.mjs --profile=mobile",
    "validation:perf": "node tools/validation/frame-time-histogram.mjs",
    "validation:all": "npm run validation:lod && npm run validation:screenshots -- --capture && npm run validation:latency && npm run validation:perf",
    "bake-heightmaps": "node scripts/bake-heightmap.mjs --scene rolling-hills --peakHeight 6 --seed 1 --out public/terrain/rolling-hills.bin && node scripts/bake-heightmap.mjs --scene field --peakHeight 0 --seed 0 --out public/terrain/field.bin && node scripts/bake-heightmap.mjs --scene open-country --peakHeight 5 --seed 42 --out public/terrain/open-country.bin",
    "bake-placement": "node tools/bake-placement.mjs"
  },
  "keywords": [
    "game",
    "simulation",
    "boids",
    "flocking",
    "three.js",
    "herding"
  ],
  "author": "Matthew Kissinger",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "@gltf-transform/cli": "^4.3.0",
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "browserstack-node-sdk": "^1.55.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.3.0",
    "jsdom": "^29.1.1",
    "mediabunny": "^1.44.2",
    "selenium-webdriver": "^4.44.0",
    "sharp": "^0.34.5",
    "simplex-noise": "^4.0.3",
    "tailwindcss": "^4.1.17",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "vite-plugin-static-copy": "^3.1.4",
    "vitest": "^4.1.5",
    "ws": "^8.20.0"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@three.ez/instanced-mesh": "^0.3.15",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.0",
    "kdbush": "^4.0.2",
    "lz-string": "^1.5.0",
    "motion": "^12.40.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.8",
    "three": "^0.184.0"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.0",
    "protobufjs": "^7.5.8",
    "qs": "6.15.2",
    "tmp": "0.2.7",
    "uuid": "^11.1.1"
  }
}
