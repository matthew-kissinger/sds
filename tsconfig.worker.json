{
  // The Worker's typecheck (`npm run typecheck:worker`). Separate from
  // tsconfig.json because the Worker runs on the Workers runtime types, not the
  // DOM ones the client uses, and the client never imports worker/ or shared/.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"],
    "lib": ["ES2022"],
    "allowJs": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["worker/src/**/*", "shared/**/*.js"]
}
