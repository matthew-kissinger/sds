# Cloudflare Pages headers — cache-control overrides
# Reference: https://developers.cloudflare.com/pages/configuration/headers/

# OG / social-card assets — short edge TTL so refreshes propagate fast
# (social scrapers cache independently; this only affects browser + CF edge)
/assets/marketing/og/*
  Cache-Control: public, max-age=300, s-maxage=300, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/assets/scenes/entrance/*
  Cache-Control: public, max-age=300, s-maxage=300, must-revalidate

# Heightfield manifests (small JSON): keep the short revalidating TTL.
/terrain/*.json
  Cache-Control: public, max-age=300, s-maxage=300, must-revalidate

# Cycle 100: heightfield binaries ship brotli-pre-compressed (vite
# precompress-terrain plugin). Declare the encoding and stop the edge from
# re-transforming it; the browser decodes transparently below fetch(), so
# Heightfield.load reads byte-identical float32 (lossless, no baseline moves).
/terrain/*.bin
  Cache-Control: public, max-age=300, s-maxage=300, must-revalidate, no-transform
  Content-Encoding: br
