{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "sds-realtime",
  "main": "index.ts",
  "account_id": "56adffd40534f7fe110fc661a40bbf53",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "limits": { "cpu_ms": 50 },
  "routes": [{ "pattern": "sheepdogsim.com/r/*", "zone_name": "sheepdogsim.com" }],
  "vars": {
    "ALLOWED_ORIGIN": "https://sheepdogsim.com",
    "ROOM_CAPS": { "na": 1, "eu": 1, "apac": 1 }
  },
  "services": [
    { "binding": "IDENTITY", "service": "sds-worker", "entrypoint": "RoomAdmission" },
    { "binding": "GAME_SHELL", "service": "sds-worker", "entrypoint": "InviteShell" }
  ],
  "durable_objects": { "bindings": [
    { "name": "ROOMS", "class_name": "RoomDO" },
    { "name": "LOBBIES", "class_name": "LobbyDO" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO", "LobbyDO"] }]
}
